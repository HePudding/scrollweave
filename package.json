{
  "name": "scrollweave",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "description": "开源滚动驱动 Web 动效编辑器 · ScrollWeave",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "dev:background": "node scripts/start-local.mjs",
    "build": "tsx scripts/build.ts",
    "build:portable": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-portable.ps1 && electron-builder --config electron-builder.json --win portable --x64",
    "start": "node dist/server.mjs",
    "mcp": "tsx server/stdio.ts",
    "test": "tsx --test tests/core.test.ts tests/persistence.test.ts tests/workspace.test.ts tests/library.test.ts tests/directory-picker.test.ts tests/agent.test.ts tests/agent-settings.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "licenses": "tsx scripts/licenses.ts",
    "example": "tsx scripts/example.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "chokidar": "5.0.0",
    "dompurify": "3.4.15",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "jsdom": "30.1.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-bezier-curve-editor": "2.1.0",
    "react-dom": "19.3.0",
    "react-moveable": "0.56.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
