{
  "name": "scrollweave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "开源滚动驱动 Web 动效编辑器 · ScrollWeave",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server.mjs",
    "mcp": "tsx server/stdio.ts",
    "test": "tsx --test tests/core.test.ts tests/persistence.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "licenses": "tsx scripts/licenses.ts",
    "example": "tsx scripts/example.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-bezier-curve-editor": "2.1.0",
    "react-dom": "19.3.0",
    "react-moveable": "0.56.0",
    "vis-data": "8.0.5",
    "vis-timeline": "8.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
